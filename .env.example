# SECUREFACE AI Configuration
APP_NAME="SECUREFACE AI"
APP_VERSION="2.0.0"
DEBUG=false

# Security & Cryptography
SECRET_KEY="secureface-super-secret-jwt-key-2026-production-ready"
# 32-byte url-safe base64 key for Fernet biometric vector encryption
FERNET_KEY="b3h8K0T7y8XpWz6L2Mv1Q4R9sA7dF5gH3jK1lZ0xN8w="

# Database
DATABASE_URL="sqlite:///./secureface.db"

# MobileNetV3 PAD Parameters (v3 PAD model)
PAD_MODEL_PATH="exports/mobilenetv3.onnx"
PAD_THRESHOLD=0.0851
PAD_CROP_MARGIN=1.4

# Face Recognition Verification (SFace Cosine Similarity)
FACE_MATCH_THRESHOLD=0.60
MIN_FACE_RESOLUTION=80
BLUR_THRESHOLD=30.0

# Default Seed Administrator
DEFAULT_ADMIN_USERNAME="admin"
DEFAULT_ADMIN_PASSWORD="SecureFace@2026"
DEFAULT_ADMIN_EMAIL="admin@secureface.ai"
